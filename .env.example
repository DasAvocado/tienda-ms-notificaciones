# Copia este archivo como ".env" (NO se sube a GitHub).
# IP PRIVADA de la instancia de infraestructura (Postgres + RabbitMQ).
RABBIT_HOST=172.31.0.10
RABBIT_USER=pedidos
RABBIT_PASSWORD=cambia-esta-clave

AZURE_TENANT_ID=d276cca8-e687-4f20-8984-601387d11401
AZURE_CLIENT_ID=39a9591b-35f1-4165-8cf2-667a2c643920

# false = no exigir roles de Azure (solo para depurar; en produccion dejar true)
REQUIRE_ROLES=true

# --- Correo ---
# Sin SPRING_MAIL_HOST el servicio SIMULA el envio (escribe el correo en el log).
#SPRING_MAIL_HOST=sandbox.smtp.mailtrap.io
#SPRING_MAIL_PORT=2525
#SPRING_MAIL_USERNAME=tu-usuario
#SPRING_MAIL_PASSWORD=tu-clave
#SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
#SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_FROM=no-reply@pedidos360.local
# Casilla real que recibira los correos de ordenes (el UPN de Entra no suele ser un buzon):
NOTIFY_OVERRIDE_TO=
# false = llamar desde Postman SIN token (SOLO pruebas locales)
SECURITY_ENABLED=true
